{
  "name": "precision-lab-rebuild",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A fresh, offline four-way Vernier caliper learning laboratory.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/offline-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs",
    "verify:archive": "python3 scripts/verify_archive.py",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4",
    "playwright": "1.62.1"
  },
  "engines": { "node": ">=22.12.0" }
}
